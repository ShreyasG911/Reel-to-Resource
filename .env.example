# ==============================================================================
# REEL TO RESOURCE MATCHER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit your real .env file with production credentials to version control.

# --- Application Runtime ---
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Local MongoDB instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/reel_to_resource

# --- Dashboard Security & Authentication ---
# Secret key used for signing JWT tokens or session tokens
DASHBOARD_JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
# Initial administrator credentials for first setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_admin_password_123

# --- Meta Instagram Graph API Configuration ---
# Your Meta Developer App ID and App Secret (from developers.facebook.com)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Connected Instagram Professional Account ID (Page-scoped or Instagram Business ID)
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Long-lived Page Access Token with instagram_manage_messages scope
META_PAGE_ACCESS_TOKEN=your_meta_long_lived_page_access_token_here

# Custom secret token you specify when setting up the webhook in Meta App Dashboard
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API Version (e.g., v21.0)
META_GRAPH_API_VERSION=v21.0

# --- Automation Settings Defaults ---
# Enable or disable automatic replies globally (true/false)
AUTO_REPLY_ENABLED=true
# Maximum processing retry attempts for transient API errors
MAX_RETRY_ATTEMPTS=3
# Simulation Mode: if true, incoming webhooks are parsed and matched, but no real Instagram message is sent
SIMULATION_MODE=false

